{
 "title": "PDP platform",
 "uid": "pdp-platform",
 "schemaVersion": 39,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "refresh": "1m",
 "panels": [
  {
   "type": "stat",
   "title": "Organisations",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "max(pdp_organisations)",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Live endpoints",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(max by (phase) (pdp_endpoints{kind=\"live\",phase!=\"retired\"}))",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Online",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(max by (phase) (pdp_endpoints_online{kind=\"live\"}))",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Alerts, last hour",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "max(pdp_alerts_last_hour)",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Last backup",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "min(pdp_backup_age_seconds)",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "type": "stat",
   "title": "Data disk free",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "min(pdp_data_free_bytes/pdp_data_total_bytes)",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Endpoints by phase",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "max by (phase) (pdp_endpoints{kind=\"live\"})",
     "legendFormat": "{{phase}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Agent versions",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "max by (version) (pdp_agent_version_endpoints)",
     "legendFormat": "{{version}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Jobs",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "max by (kind, state) (pdp_jobs)",
     "legendFormat": "{{kind}} {{state}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Oldest waiting job",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "max by (kind) (pdp_job_oldest_seconds{state=\"queued\"})",
     "legendFormat": "{{kind}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Baseline events uploaded / hour",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "max(pdp_baseline_events_last_hour)",
     "legendFormat": "events",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Database size",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "max by (db) (pdp_db_bytes)",
     "legendFormat": "{{db}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   }
  }
 ]
}