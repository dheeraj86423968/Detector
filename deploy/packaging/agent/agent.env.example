# /etc/pdp/agent.env (mode 0600), read by pdp-agent.service. pdp-agent-install writes it for you.
# Values here override the unit's Environment= defaults.
#
# One-time enrolment token from the console (Endpoints -> Enrol). Ignored once this host is enrolled.
PDP_ENROLL_TOKEN=
# CA fingerprint shown next to the token (hex sha256 of the CA certificate DER).
PDP_CA_SHA256=
# Agent image to run (registry reference, or a tag loaded with `docker load`).
#PDP_AGENT_IMAGE=registry.example.com/pdp/agent:0.3.0
