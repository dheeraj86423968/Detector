{
  "name": "pdp-console-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Desktop wrapper for the PDP analyst console",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:all": "electron-builder -mwl"
  },
  "devDependencies": {
    "electron": "31.7.6",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.pdp.console",
    "productName": "PDP Console",
    "files": ["main.js", "pin.js", "preload.js", "settings.html", "icon.*"],
    "mac": { "category": "public.app-category.developer-tools", "target": ["dmg", "zip"] },
    "win": { "target": ["nsis", "zip"] },
    "linux": { "target": ["AppImage", "deb"], "category": "Security" }
  }
}
