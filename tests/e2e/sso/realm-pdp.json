      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "alice-pass-123",
          "temporary": false
        }
      ],
      "groups": [
        "pdp-admins"
      ],
      "id": "0f3c1c1e-0000-4000-8000-00000000a11c"
    },
    {
