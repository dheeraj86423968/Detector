{
  "realm": "pdp",
  "enabled": true,
  "sslRequired": "none",
  "groups": [
    {
      "name": "pdp-admins"
    },
    {
      "name": "pdp-analysts"
    },
    {
      "name": "marketing"
    }
  ],
  "clients": [
    {
      "clientId": "pdp-console",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "test-client-secret-not-for-production",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "https://gateway/api/oidc/callback"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://gateway/*"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
